{
  "name": "xoxoeditz",
  "version": "0.1.0",
  "description": "XOXOEDITZ — an autonomous Adobe After Effects video-editing agent for Claude Code. Assets + prompt in, finished video out.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "bin": {
    "xoxo": "bin/xoxo.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "node bin/xoxo.js setup",
    "doctor": "node bin/xoxo.js doctor",
    "test": "node scripts/lint-jsx.js && node scripts/run-tests.js",
    "lint:jsx": "node scripts/lint-jsx.js",
    "mcp": "node bin/xoxo.js mcp",
    "test:fast": "node scripts/lint-jsx.js && node scripts/run-tests.js --fast",
    "docs": "node scripts/gen-docs.js",
    "benchmark": "node bin/xoxo.js benchmark"
  },
  "keywords": [
    "after-effects",
    "video-editing",
    "automation",
    "claude-code",
    "mcp",
    "extendscript"
  ]
}
